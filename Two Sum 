# Taking inputs in array
nums = list(map(int, input("Enter values in array: ").split()))
target = int(input("Enter the target: "))

#logic
found = False

for i in range(len(nums)):
    for j in range(i + 1, len(nums)):
        if nums[i] + nums[j] == target:
            print((i, j))
            found = True

if not found:
    print("Not found")